{
  "name": "encodeomatic2",
  "version": "1.0.0",
  "description": "A client-side visual encoding/decoding pipeline tool, hosted on [GitHub Pages](https://david-risney.github.io/EncodeOMatic2/).",
  "scripts": {
    "build:vendor": "rollup -c rollup.config.vendor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "node --check sw.js && find src tests -name \"*.js\" -print0 | xargs -0 -n1 node --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-risney/EncodeOMatic2.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/david-risney/EncodeOMatic2/issues"
  },
  "homepage": "https://github.com/david-risney/EncodeOMatic2#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "buffer": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "rollup": "^4.62.2",
    "string_decoder": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "dependencies": {
    "apg-js": "^4.4.0",
    "ascii85": "^1.0.2",
    "bs58": "^6.0.0",
    "emailjs-mime-codec": "^2.0.9",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "he": "^1.2.0",
    "iconv-lite": "^0.7.3",
    "nearley": "^2.20.1",
    "peggy": "^5.1.0",
    "punycode": "^2.3.1",
    "quoted-printable": "^1.0.1",
    "rfc4648": "^1.5.4"
  }
}
